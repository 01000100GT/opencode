{
  "folders": [
    {
      "name": "OpenCode (Host)",
      "path": "."
    },
    {
      "name": "oh-my-opencode (Plugin)",
      "path": "../oh-my-opencode"
    }
  ],
  "settings": {
    "typescript.tsdk": "node_modules/typescript/lib",
    "cSpell.words": ["opencode", "opencode's", "oh-my-opencode"],
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.turbo": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/bun.lockb": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build oh-my-opencode",
        "type": "shell",
        "command": "bun",
        "args": ["run", "build"],
        "options": {
          "cwd": "${workspaceFolder:oh-my-opencode (Plugin)}"
        },
        "problemMatcher": ["$tsc"],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        }
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "bun",
        "request": "launch",
        "name": "OpenCode + Plugin (联调)",
        "runtime": "bun",
        "runtimeArgs": [
          "--inspect-wait",
          "run",
          "--conditions=browser"
        ],
        "program": "src/index.ts",
        "args": ["run", "你好"],
        "cwd": "${workspaceFolder:OpenCode (Host)}/packages/opencode",
        "stopOnEntry": false
      }
    ]
  }
}
